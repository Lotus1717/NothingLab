# DeepSeek（必填，切勿提交到 Git）
DEEPSEEK_API_KEY=

# SQLite 配额库（Docker 默认挂载 /data；本地开发可用 ./data/quota.db）
# SQLITE_PATH=/data/quota.db
# 或指定数据目录（自动使用 {DATA_DIR}/quota.db）
# DATA_DIR=/data

# 可选覆盖
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_SECONDS=30
# DAILY_LIMIT=50
# QUOTA_TIMEZONE=Asia/Shanghai
# PORT=8000

# 可选：保护 POST /v1/register（Bearer token）
# REGISTER_API_KEY=
